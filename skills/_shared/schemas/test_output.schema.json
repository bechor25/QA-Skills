{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentResult",
  "description": "Uniform return shape for every test-generation sub-agent. `outputs[]` holds per-spec records. `status` is a closed enum: passed | partial | error | skipped:<reason_code>.",
  "type": "object",
  "required": ["agent", "status", "outputs"],
  "properties": {
    "agent": { "type": "string" },
    "status": {
      "type": "string",
      "description": "Closed enum: passed | partial | error | skipped:<reason_code>. Reason codes follow the path-contract.md error-code list.",
      "pattern": "^(passed|partial|error|skipped:[a-z0-9_:]+)$"
    },
    "reason": { "type": ["string", "null"] },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Test file path. MUST satisfy path_contract.required_pattern.",
            "pattern": "^tests/(unit|api|ui|security|a11y|contract)/(?:[^/]+/)+(test_[^/]+\\.py|[^/]+\\.(spec|test|api\\.test|security\\.test|contract\\.test|a11y\\.spec)\\.(ts|js))$"
          },
          "covers": {
            "type": "array",
            "description": "Mirror of expected_files[i].covers — the exact items this test file covers. Source modules for unit, 'METHOD /path' strings for api/security/contract, frontend file paths for ui/a11y. Never empty for a passed/partial output.",
            "items": { "type": "string", "minLength": 1 }
          },
          "source_module":   { "type": "string", "description": "Optional convenience copy of the primary covered item." },
          "tests_written":   { "type": "integer", "minimum": 0 },
          "tests_passing":   { "type": "integer", "minimum": 0 },
          "assertions_covered": { "type": "array", "items": { "type": "string" }, "default": [] },
          "execution_result":{ "type": "string", "enum": ["passed", "failed", "partial", "skipped"] },
          "vulnerabilities_found": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["category", "rule", "module_path", "module_hash", "line_range", "test_path"],
              "properties": {
                "category":         { "type": "string" },
                "rule":             { "type": "string" },
                "module_path":      { "type": "string" },
                "module_hash":      { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "line_range":       { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
                "test_path":        { "type": "string" },
                "description":      { "type": "string" },
                "suggested_fix":    { "type": "string" },
                "matched_prior_id": { "type": ["string", "null"] },
                "execution_result": { "type": "string" }
              }
            }
          },
          "violations_summary": {
            "type": "object",
            "properties": {
              "critical": { "type": "integer", "minimum": 0 },
              "serious":  { "type": "integer", "minimum": 0 },
              "moderate": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "batches_completed":   { "type": "array", "items": { "type": "string" }, "default": [] },
    "batches_skipped":     { "type": "array", "items": { "type": "string" }, "default": [] },
    "artifacts_dir":       { "type": ["string", "null"] },
    "html_report":         { "type": ["string", "null"] },
    "findings":            { "type": "array", "items": { "type": "object" }, "default": [] },
    "tokens_used_estimate":{ "type": "integer", "minimum": 0 },
    "elapsed_seconds":     { "type": "number",  "minimum": 0 },
    "warnings":            { "type": "array",   "items": { "type": "string" }, "default": [] }
  }
}
