{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportData",
  "type": "object",
  "required": ["version", "run_id", "project_root", "language", "locale", "generated_at", "run_type", "quality_score", "summary", "coverage_by_category", "modules", "vulnerabilities_found", "ui_artifacts", "a11y_artifacts"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "run_id": { "type": "string" },
    "project_name": { "type": "string" },
    "project_root": { "type": "string" },
    "language": { "type": "string" },
    "locale": { "type": "string", "enum": ["he", "en"] },
    "generated_at": { "type": "string" },
    "run_type": { "type": "string", "enum": ["full", "incremental"] },
    "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "summary": {
      "type": "object",
      "properties": {
        "modules_total": { "type": "integer" },
        "tests_new":       { "type": "integer" },
        "tests_updated":   { "type": "integer" },
        "tests_unchanged": { "type": "integer" },
        "flaky_count":     { "type": "integer" }
      }
    },
    "vulnerabilities_found": { "type": "array", "default": [] },
    "coverage_by_category": {
      "type": "object",
      "description": "Per-category coverage. Each value uses real-units math from qa_skills.coverage: pct = |covered ∩ universe| / |universe|.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Closed enum: passed | partial | error | skipped:<reason>.",
            "pattern": "^(passed|partial|error|skipped:[a-z0-9_:]+)$"
          },
          "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
          "total": { "type": "integer", "minimum": 0, "description": "Universe size for this category." },
          "covered_items": {
            "type": "array",
            "default": [],
            "items": { "type": "string" },
            "description": "Real-units actually covered by agent outputs. Subset of universe."
          },
          "missing_items": {
            "type": "array",
            "default": [],
            "items": { "type": "string" },
            "description": "Universe items NOT covered. Surfaced in HTML report as actionable gaps."
          },
          "files": {
            "type": "array",
            "default": [],
            "items": { "type": "string" },
            "description": "Test file paths produced by the source agent. Subset of agent_output.outputs[].path."
          },
          "tests": { "type": "integer", "minimum": 0 },
          "tests_new": { "type": "integer", "minimum": 0 },
          "tokens": { "type": "integer", "minimum": 0 },
          "reason": { "type": ["string", "null"] },
          "action": { "type": ["string", "null"] },
          "critical_violations": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "modules": { "type": "array" },
    "gaps": { "type": "array", "default": [] },
    "blind_spots": { "type": "array", "default": [] },
    "recommendations": { "type": "array", "default": [] },
    "flaky_tests": { "type": "array", "default": [] },
    "timeline": { "type": "array", "default": [] },
    "warnings": { "type": "array", "default": [] },
    "run_log": { "type": "array", "default": [] },
    "ui_artifacts": {
      "type": ["object", "null"],
      "default": null,
      "properties": {
        "playwright_report": { "type": ["string", "null"] },
        "test_results_dir":  { "type": ["string", "null"] },
        "screenshots":       { "type": "array", "items": { "type": "string" }, "default": [] },
        "videos":            { "type": "array", "items": { "type": "string" }, "default": [] },
        "traces":            { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "a11y_artifacts": {
      "type": ["object", "null"],
      "default": null,
      "properties": {
        "axe_report":       { "type": ["string", "null"] },
        "test_results_dir": { "type": ["string", "null"] },
        "screenshots":      { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    }
  }
}
