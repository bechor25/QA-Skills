{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeAnalysis",
  "description": "Output of qa-code-analyzer. Sole authority for project structure consumed by orchestrator path planner. v1 supports typescript/javascript/python only.",
  "type": "object",
  "required": ["language", "scanned_at", "project_root", "modules", "routes", "stats"],
  "properties": {
    "language": { "type": "string", "enum": ["typescript", "javascript", "python", "multi"] },
    "additional_languages": { "type": "array", "items": { "type": "string" }, "default": [] },
    "scanned_at": { "type": "string", "format": "date-time" },
    "project_root": { "type": "string" },
    "frontend_dev_server": { "type": ["string", "null"], "default": null },
    "backend_dev_server":  { "type": ["string", "null"], "default": null },
    "frontend_kind": { "type": "string", "enum": ["spa", "ssr", "mixed", "none"], "default": "none" },
    "server_hint": {
      "type": ["object", "null"],
      "default": null,
      "description": "Deterministic server lifecycle hint built from package.json scripts / Python entrypoints. Orchestrator turns this into a server_plan. Null when nothing detectable.",
      "properties": {
        "backend_command":  { "type": ["string", "null"], "default": null },
        "backend_port":     { "type": ["integer", "null"], "default": null },
        "frontend_command": { "type": ["string", "null"], "default": null },
        "frontend_port":    { "type": ["integer", "null"], "default": null },
        "framework":        { "type": ["string", "null"], "enum": ["fastapi", "flask", "django", "next", "vite", "nuxt", "express", "remix", "astro", null], "default": null }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash", "type"],
        "properties": {
          "path": { "type": "string", "description": "Project-relative source path. e.g. 'app/auth.py'." },
          "hash": { "type": "string", "description": "SHA-256 of file bytes." },
          "type": { "type": "string", "enum": ["service", "controller", "model", "util", "middleware", "frontend"] },
          "exports": { "type": "array", "items": { "type": "string" }, "default": [] },
          "dependencies": { "type": "array", "items": { "type": "string" }, "default": [] },
          "has_db_queries": { "type": "boolean", "default": false },
          "has_http_calls": { "type": "boolean", "default": false },
          "has_auth": { "type": "boolean", "default": false },
          "input_fields": { "type": "array", "items": { "type": "string" }, "default": [] },
          "diff_class": { "type": "string", "enum": ["signature_changed", "body_changed", "trivial", "unchanged", "unknown"], "default": "unknown" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "handler", "file", "kind", "produces"],
        "properties": {
          "method":        { "type": "string" },
          "path":          { "type": "string", "description": "URL path including any /api/ prefix as written in source." },
          "handler":       { "type": "string", "description": "Function/method name handling the route." },
          "file":          { "type": "string", "description": "Source file containing the handler. NOT to be confused with modules[].path." },
          "requires_auth": { "type": "boolean", "default": false },
          "kind":          { "type": "string", "enum": ["api", "page", "asset", "unknown"], "description": "api=JSON endpoint; page=server-rendered HTML; asset=static; unknown=fallback." },
          "produces":      { "type": "string", "enum": ["json", "html", "unknown"], "default": "unknown" },
          "source":        { "type": ["string", "null"], "default": null, "description": "Framework hint, e.g. 'fastapi.APIRouter', 'flask.app.route', 'next.pages.api'." }
        }
      }
    },
    "frontend_files": {
      "type": "array",
      "default": [],
      "description": "Always object array. Every entry has path/hash/kind/has_forms. Never bare string.",
      "items": {
        "type": "object",
        "required": ["path", "hash", "kind"],
        "properties": {
          "path":      { "type": "string" },
          "hash":      { "type": "string" },
          "kind":      { "type": "string", "enum": ["spa_component", "ssr_template", "static_html", "page", "partial", "layout"] },
          "has_forms": { "type": "boolean", "default": false }
        }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "total_files": { "type": "integer" },
        "by_type": { "type": "object" },
        "has_auth": { "type": "boolean" },
        "has_db": { "type": "boolean" },
        "has_api": { "type": "boolean" },
        "has_frontend": { "type": "boolean" },
        "frontend_kind": { "type": "string", "enum": ["spa", "ssr", "mixed", "none"] }
      }
    },
    "warnings": { "type": "array", "default": [] },
    "skipped_files": { "type": "array", "default": [] },
    "external_integrations": { "type": "array", "default": [] },
    "uploads": { "type": "array", "default": [] },
    "graphql": { "type": ["object", "null"], "default": null },
    "state_machines": { "type": "array", "default": [] }
  }
}
