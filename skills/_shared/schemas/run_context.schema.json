{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunContext",
  "description": "Small (<5KB) shared object the orchestrator builds once and threads through every Task call. Large data lives on disk; only paths are passed.",
  "type": "object",
  "required": ["run_id", "project_root", "language", "user_locale", "categories_enabled"],
  "properties": {
    "run_id": { "type": "string" },
    "project_root": { "type": "string" },
    "language": { "type": "string", "enum": ["typescript", "javascript", "python", "java", "kotlin", "csharp", "multi"] },
    "additional_languages": { "type": "array", "items": { "type": "string" }, "default": [] },
    "user_locale": { "type": "string", "enum": ["he", "en"], "default": "en" },
    "categories_enabled": {
      "type": "array",
      "items": { "type": "string", "enum": ["unit", "api", "ui", "security", "a11y", "contract", "flaky", "env", "diff", "mutation", "performance"] }
    },
    "checkpoint_dir": { "type": "string" },
    "logs_dir":       { "type": "string" },
    "analysis_path":  { "type": "string" },
    "state_path":     { "type": "string" },
    "mode": { "type": "string", "enum": ["auto", "interactive"], "default": "auto" },
    "changed_count": { "type": "integer", "minimum": 0 },
    "new_count":     { "type": "integer", "minimum": 0 },
    "priors": {
      "type": "object",
      "default": {},
      "additionalProperties": { "type": "array" }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "global_token_cap":          { "type": "integer", "default": 200000 },
        "per_agent_max_tokens":      { "type": "integer", "default": 80000 },
        "per_agent_timeout_seconds": { "type": "integer", "default": 600 }
      }
    }
  }
}
