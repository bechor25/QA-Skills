<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>QA Agent Report — {{ data.project.root }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  :root {
    --bg: #0b0f17;
    --panel: #131a26;
    --panel-2: #1c2533;
    --text: #e8ecf2;
    --muted: #98a4b8;
    --accent: #4ea1ff;
    --good: #4ade80;
    --warn: #facc15;
    --bad: #f87171;
    --high: #ef4444;
    --med: #f59e0b;
    --low: #22c55e;
    --border: #223047;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, sans-serif;
         background: var(--bg); color: var(--text); }
  header { padding: 28px 36px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  header h1 { margin: 0; font-size: 22px; letter-spacing: 0.2px; }
  header .meta { color: var(--muted); font-size: 13px; }
  main { max-width: 1240px; margin: 28px auto; padding: 0 32px; display: grid; grid-template-columns: 1fr; gap: 22px; }
  section { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 22px 26px; }
  section h2 { font-size: 16px; margin: 0 0 14px; letter-spacing: 0.3px; color: var(--muted); text-transform: uppercase; }
  .row { display: flex; gap: 18px; flex-wrap: wrap; }
  .card { background: var(--panel-2); border: 1px solid var(--border); border-radius: 10px; padding: 18px; min-width: 180px; flex: 1; }
  .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; }
  .card .value { font-size: 28px; font-weight: 700; margin-top: 6px; }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .badge.high { background: rgba(239, 68, 68, 0.15); color: var(--high); }
  .badge.medium { background: rgba(245, 158, 11, 0.15); color: var(--med); }
  .badge.low { background: rgba(34, 197, 94, 0.15); color: var(--low); }
  .badge.passed { background: rgba(74, 222, 128, 0.15); color: var(--good); }
  .badge.failed { background: rgba(248, 113, 113, 0.15); color: var(--bad); }
  .badge.skipped { background: rgba(152, 164, 184, 0.12); color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { padding: 9px 12px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  th { color: var(--muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.4px; }
  tr:last-child td { border-bottom: none; }
  code { background: var(--panel-2); padding: 1px 6px; border-radius: 4px; font-size: 12px; }
  .empty { color: var(--muted); font-style: italic; padding: 8px 0; }
  .score-circle { display: inline-block; width: 96px; height: 96px; border-radius: 50%; background: conic-gradient(var(--accent) calc(var(--pct) * 1%), var(--panel-2) 0); position: relative; }
  .score-circle::after { content: attr(data-score); position: absolute; inset: 8px; background: var(--panel); border-radius: 50%;
                         display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; }
</style>
</head>
<body>
<header>
  <div>
    <h1>QA Agent — enterprise report</h1>
    <div class="meta">{{ data.project.root }}</div>
  </div>
  <div class="meta">Generated {{ data.generated_at }}</div>
</header>

<main>
  <section>
    <h2>Executive summary</h2>
    <div class="row">
      <div class="card" style="display: flex; align-items: center; gap: 18px;">
        <div class="score-circle" data-score="{{ data.executive_summary.quality_score }}" style="--pct: {{ data.executive_summary.quality_score }};"></div>
        <div>
          <div class="label">Quality score</div>
          <div class="value" style="font-size: 14px; margin-top: 4px;">0–100 (deterministic)</div>
        </div>
      </div>
      <div class="card"><div class="label">Tests run</div><div class="value">{{ data.executive_summary.tests_total }}</div></div>
      <div class="card"><div class="label">Pass rate</div><div class="value">{{ data.executive_summary.pass_rate }}%</div></div>
      <div class="card"><div class="label">Passed</div><div class="value" style="color: var(--good);">{{ data.executive_summary.passed }}</div></div>
      <div class="card"><div class="label">Failed</div><div class="value" style="color: var(--bad);">{{ data.executive_summary.failed }}</div></div>
      <div class="card"><div class="label">Skipped</div><div class="value">{{ data.executive_summary.skipped }}</div></div>
      <div class="card"><div class="label">Flaky</div><div class="value" style="color: var(--warn);">{{ data.executive_summary.flaky }}</div></div>
      <div class="card"><div class="label">Critic avg</div><div class="value">{{ "%.1f"|format(data.executive_summary.critique_avg) }}/10</div></div>
      <div class="card">
        <div class="label">Effective coverage</div>
        <div class="value">{{ "%.0f"|format((data.coverage.effective_coverage or 0) * 100) }}%</div>
        <div class="label" style="font-size: 11px; color: var(--muted);">passed / attempted</div>
      </div>
    </div>
    <p style="color: var(--muted); margin-top: 14px;">{{ data.project.summary }}</p>
  </section>

  <section>
    <h2>Risk coverage map</h2>
    {% if data.risk %}
    <table>
      <thead>
        <tr><th>Capability</th><th>Score</th><th>Band</th><th>Business</th><th>State</th><th>Security</th><th>Change</th><th>Rationale</th></tr>
      </thead>
      <tbody>
      {% for r in data.risk %}
        <tr>
          <td><code>{{ r.capability }}</code></td>
          <td>{{ r.score }}</td>
          <td><span class="badge {{ r.band }}">{{ r.band }}</span></td>
          <td>{{ r.axes.business_impact }}</td>
          <td>{{ r.axes.state_complexity }}</td>
          <td>{{ r.axes.security_exposure }}</td>
          <td>{{ r.axes.change_frequency }}</td>
          <td style="color: var(--muted); font-size: 12px;">{{ r.rationale }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="empty">no risk entries</div>{% endif %}
  </section>

  <section>
    <h2>Strategy</h2>
    {% if data.strategy %}
    <table>
      <thead><tr><th>Capability</th><th>Priority</th><th>Categories</th><th>Rationale</th></tr></thead>
      <tbody>
      {% for s in data.strategy %}
        <tr>
          <td><code>{{ s.capability }}</code></td>
          <td>{{ s.priority }}</td>
          <td>{% for c in s.categories %}<span class="badge low">{{ c }}</span> {% endfor %}</td>
          <td style="color: var(--muted); font-size: 12px;">{{ s.rationale }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="empty">no strategy</div>{% endif %}
  </section>

  <section>
    <h2>Test results — by category (last run)</h2>
    {% set lc = data.tests.last_run_by_category %}
    {% if lc %}
    <table>
      <thead><tr><th>Category</th><th>Passed</th><th>Failed</th><th>Skipped</th></tr></thead>
      <tbody>
      {% for cat, r in lc.items() %}
        <tr>
          <td><code>{{ cat }}</code></td>
          <td><span class="badge passed">{{ r.passed }}</span></td>
          <td><span class="badge failed">{{ r.failed }}</span></td>
          <td><span class="badge skipped">{{ r.skipped }}</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="empty">no execution history yet</div>{% endif %}
  </section>

  <section>
    <h2>Flaky tests</h2>
    {% if data.flaky %}
    <table>
      <thead><tr><th>Test</th><th>Cause</th><th>Runs / Failures</th><th>Last seen</th><th>Rationale</th></tr></thead>
      <tbody>
      {% for f in data.flaky %}
        <tr>
          <td><code>{{ f.test_id }}</code></td>
          <td><span class="badge medium">{{ f.classification }}</span></td>
          <td>{{ f.runs }} / {{ f.failures }}</td>
          <td>{{ f.last_seen }}</td>
          <td style="color: var(--muted); font-size: 12px;">{{ f.rationale }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="empty">no flakes detected</div>{% endif %}
  </section>

  <section>
    <h2>Critique findings</h2>
    {% if data.critique.files_reviewed %}
    <div class="row" style="margin-bottom: 14px;">
      <div class="card"><div class="label">Files reviewed</div><div class="value">{{ data.critique.files_reviewed }}</div></div>
      <div class="card"><div class="label">Avg score</div><div class="value">{{ data.critique.avg_score }}/10</div></div>
    </div>
    {% if data.critique.by_rule %}
    <table>
      <thead><tr><th>Rule</th><th>Hits</th></tr></thead>
      <tbody>
      {% for rule, n in data.critique.by_rule.items() %}
        <tr><td><code>{{ rule }}</code></td><td>{{ n }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="empty">no findings</div>{% endif %}
    {% else %}<div class="empty">no critique data</div>{% endif %}
  </section>

  <section>
    <h2>Installation log</h2>
    {% if data.installations %}
    <table>
      <thead><tr><th>Time</th><th>Manager</th><th>Args</th><th>Exit</th><th>Duration</th></tr></thead>
      <tbody>
      {% for i in data.installations %}
        <tr>
          <td style="color: var(--muted); font-size: 12px;">{{ i.timestamp }}</td>
          <td><code>{{ i.manager }}</code></td>
          <td><code>{{ i.args|join(' ') }}</code></td>
          <td>{% if i.exit_code == 0 %}<span class="badge passed">ok</span>{% else %}<span class="badge failed">{{ i.exit_code }}</span>{% endif %}</td>
          <td>{{ "%.1fs"|format(i.duration_seconds) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="empty">no installs recorded</div>{% endif %}
  </section>
</main>
</body>
</html>
