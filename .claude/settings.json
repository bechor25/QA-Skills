{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-python-edit.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-skill-budgets.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'git -C \"$CLAUDE_PROJECT_DIR\" diff --quiet -- qa_agent || echo \"reminder: qa_agent/ changed — run: pytest qa_agent/tests and paste the summary as evidence\"'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
